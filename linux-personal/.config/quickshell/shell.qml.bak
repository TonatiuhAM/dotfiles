//@ pragma UseQApplication

import Quickshell
import Quickshell.Services.Notifications
import QtQuick

ShellRoot {
    id: root
    
    // Instanciar el gestor de notificaciones
    NotificationManager {
        id: notificationManager
    }
    
    // Guardar en estado global
    Component.onCompleted: {
        GlobalState.notificationManager = notificationManager;
        console.log("✓ NotificationManager guardado en GlobalState");
    }
    
    NotificationServer {
        id: notificationServer
        
        onNotification: (notification) => {
            console.log("✓ Notificación recibida:", notification.summary);
            notification.tracked = true;
            
            // Agregar a la lista
            notificationManager.add(notification);
            console.log("→ Notificaciones activas:", notificationManager.notifications.length);
        }
    }

    Bar {}
    VolumeOSD {}
    NotificationPopups {
        notificationManager: notificationManager
    }
    
    NotificationCenter {
        id: notificationCenter
        visible: true
    }
}
