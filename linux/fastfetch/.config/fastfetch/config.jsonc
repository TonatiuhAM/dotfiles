{
  "logo": {
    "source": "~/.config/fastfetch/img/bonsai.txt",
    "type": "file",
    "width": 17,
    "height": 4,
    "color": {
      "1": "green",
      "2": "yellow",
    },
    "padding": {
      "top": 0,
      "left": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "title": "red",
      "keys": "blue",
      "output": "white",
    },
    "key": {
      "width": 10
    }
  },
  "modules": [
    {
      "type": "title",
      "keyColor": "yellow"
    },
    {
      "type": "os",
      "key": "OS",
    },
    {
      "type": "disk",
      "key": "Disk",
    },
    {
      "type": "packages",
      "key": "Packages",
    },
    {
      "type": "command",
      "key": "Opened",
      "text": "date '+%I:%M:%S %p  %d-%m-%Y'"
    }
  ]
}
