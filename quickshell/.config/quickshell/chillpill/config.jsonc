{
  "displayPicture": "~/.pfp.png",
  "clockFormat": "h:mm AP",
  "pillTopMargin": 9,
  "pillBottomMargin": 26,
  "theme": "catppuccin-mocha",
  "pillModules": [
    "fedora",
    "workspaces",
    "spacer",
    "clock",
    "spacer",
    "volume",
    "network"
  ],
  "pillOnHover": false,
  "textFontFamily": "SFMono Nerd Font",
  "nerdFontFamily": "SFMono Nerd Font",
  "timerPresets": [
    1,
    5,
    10,
    15,
    30
  ],
  "mediaPopupDuration": 2000,
  "maxWorkspaces": 5,
  "notificationDisplayTime": 3000,
  "maxNotificationsInStack": 20,
  "screenLockAppCommand": "pidof hyprlock || hyprlock",
  "osdDuration": 800,
  "weatherLocation": "Mexico City",
  "weatherUnits": "metric",
  "weatherRefreshInterval": 3600000,
  "avoidDuplicateNotifications": true,
  "defaultTerminal": "kitty",
  "pillScale": 1.00,
  "dpiScale": 1.25,
  "wallpapersDir": "~/Wallpapers",
  "customWallpaperScript": "",
  "wsCloseOnWallpaperSet": true,
  "wsAnimation": true,
  "deleteCliphistImgCache": true,
  "country": "MX",
  "holidaysEnabled": false,
  "holidaysAllCategories": false,
  "holidaysCategories": "public",
  "holidaysSubdiv": "",
  "showAudioVisuals": true,
  "showSensitiveInfo": true,
  "showShadows": true,
  "confirmPowerActions": true,
  "lockscreenPowerActions": true,
  "lockscreenMedia": true,
  "maxVolume": 100,
  "separatePreviewTabTypes": true,
  "appLauncherFuzzySearch": false,
  "cliphistFuzzySearch": false,
  "webSearchUrl": "https://duckduckgo.com/?q=%s",
  "mediaCoverBackground": "",
  "mediaMarqueeText": "",
  "mediaSeekBar": "",
  "mediaTimes": "",
  "mediaTransport": "",
  "marqueeMediaText": false,
  "iNeedMediaPlayingPopup": true
}
